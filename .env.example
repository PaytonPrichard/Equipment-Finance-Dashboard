# Copy to .env.local and fill in. .env.local is gitignored.
# The same values are set per environment in the Vercel project.

# Supabase. Required by the app.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role. Server side only, used by the serverless functions
# and by scripts that write on behalf of a user. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic. The only LLM in the product, used by server-lib/extract.js to
# read deal documents. Without it, document upload returns "Deal sheet
# parsing is not configured" and scripts/capture-demo-extraction.js will not
# run.
ANTHROPIC_API_KEY=sk-ant-...

# FRED. The live SOFR feed behind /api/sofr. Without it the app silently
# falls back to DEFAULT_SOFR and prices every deal at the built-in rate.
# Free key from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your-fred-key
